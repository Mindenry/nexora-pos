# NEXORA POS environment
# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
DATABASE_URL=postgresql://nexora:CHANGE_ME@127.0.0.1:5432/nexora_dev
TEST_DATABASE_URL=postgresql://nexora:CHANGE_ME@127.0.0.1:5432/nexora_test
SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
# 32-byte key for PromptPay identifier encryption (64 hex chars or base64).
# If omitted, a domain-separated key is derived from SESSION_SECRET.
PROMPTPAY_ENCRYPTION_KEY=
API_PORT=4000
WEB_ORIGIN=http://localhost:5173
# Extra allowed browser origins for LAN/tablet testing, comma separated.
WEB_ORIGINS=
UPLOAD_DIR=./uploads
